{
  "name": "nuclear-decay-lab",
  "version": "2.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "A browser-local scientific toolkit for single-nuclide radioactive decay.",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/build-portable.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:build": "node scripts/verify-build.mjs"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "recharts": "3.2.1",
    "lucide-react": "0.468.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "26.1.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/jest-dom": "6.6.3"
  }
}
